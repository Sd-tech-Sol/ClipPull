<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClipPull</RootNamespace>
    <AssemblyName>ClipPull</AssemblyName>
    <ApplicationIcon>Assets\clippull.ico</ApplicationIcon>
    <Version>0.3.0</Version>
    <Authors>Sébastien Dubé</Authors>
    <Description>Portable Windows downloader powered by yt-dlp, with queues, quality selection, audio, playlists, preview and local history.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
