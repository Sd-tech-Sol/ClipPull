<ui:FluentWindow
    x:Class="ClipPull.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ClipPull.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:ClipPull.ViewModels"
    mc:Ignorable="d"
    Title="ClipPull"
    Width="900"
    Height="820"
    MinWidth="720"
    MinHeight="600"
    d:DataContext="{d:DesignInstance vm:MainViewModel, IsDesignTimeCreatable=True}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    AllowDrop="True"
    PreviewDragOver="OnPreviewDragOver"
    Drop="OnDrop">

    <ui:FluentWindow.Resources>
        <converters:StateToSymbolConverter x:Key="StateToSymbolConverter" />
        <converters:ActiveStateToVisibilityConverter x:Key="ActiveStateToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <SolidColorBrush x:Key="Accent0" Color="#4A78D0" />
        <SolidColorBrush x:Key="Accent1" Color="#2E9E8F" />
        <SolidColorBrush x:Key="Accent2" Color="#C98A2E" />
        <SolidColorBrush x:Key="Accent3" Color="#B25C86" />
        <SolidColorBrush x:Key="Accent4" Color="#5F9E4E" />
        <SolidColorBrush x:Key="Accent5" Color="#6B6F9E" />

        <Style x:Key="QueueStateIconStyle" TargetType="ui:SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Symbol" Value="{Binding State, Converter={StaticResource StateToSymbolConverter}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Completed">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Cancelled">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource Accent0}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AccentIndex}" Value="1">
                    <Setter Property="Fill" Value="{StaticResource Accent1}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AccentIndex}" Value="2">
                    <Setter Property="Fill" Value="{StaticResource Accent2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AccentIndex}" Value="3">
                    <Setter Property="Fill" Value="{StaticResource Accent3}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AccentIndex}" Value="4">
                    <Setter Property="Fill" Value="{StaticResource Accent4}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AccentIndex}" Value="5">
                    <Setter Property="Fill" Value="{StaticResource Accent5}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="ClipPull"
            ShowMaximize="True"
            ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="ArrowDownload24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="28,8,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: subtitle + unobtrusive dependency chips + advanced-options entry point -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="Facebook · TikTok · Instagram · YouTube · X · Vimeo · et plus"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    FontSize="13"
                    VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding YtDlpStatusText, StringFormat='yt-dlp : {0}'}"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        FontSize="11.5"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        ToolTip="État du moteur yt-dlp" />
                    <TextBlock
                        Text="{Binding FfmpegStatusText, StringFormat='FFmpeg : {0}'}"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        FontSize="11.5"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        ToolTip="État de FFmpeg" />
                    <ui:Button
                        x:Name="AdvancedButton"
                        Appearance="Transparent"
                        Icon="{ui:SymbolIcon Settings24}"
                        ToolTip="Options avancées"
                        Command="{Binding ToggleAdvancedCommand}" />

                    <ui:Flyout Placement="Left" IsOpen="{Binding IsAdvancedOpen}">
                        <StackPanel Width="300">
                            <ui:TextBlock Text="Options avancées" FontTypography="Subtitle" Margin="0,0,0,12" />

                            <ui:TextBlock Text="Historique local" FontTypography="BodyStrong" Margin="0,0,0,4" />
                            <ui:ToggleSwitch
                                OnContent="Éviter les doublons avec l'historique"
                                OffContent="Éviter les doublons avec l'historique"
                                IsChecked="{Binding UseHistory}"
                                Margin="0,0,0,4" />
                            <ui:Button Content="Effacer l'historique" Appearance="Transparent" HorizontalAlignment="Left" Command="{Binding ClearHistoryCommand}" Margin="0,0,0,16" />

                            <ui:TextBlock Text="Playlists" FontTypography="BodyStrong" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="Limite par lien" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ui:NumberBox
                                    Value="{Binding PlaylistLimit}"
                                    Minimum="1"
                                    Maximum="500"
                                    IsEnabled="{Binding IsPlaylistLimitEnabled}"
                                    Width="100" />
                            </StackPanel>

                            <ui:TextBlock Text="Session navigateur" FontTypography="BodyStrong" Margin="0,0,0,4" />
                            <ui:ToggleSwitch
                                OnContent="Utiliser ma session si nécessaire"
                                OffContent="Utiliser ma session si nécessaire"
                                IsChecked="{Binding UseBrowserCookies}"
                                Margin="0,0,0,6" />
                            <ComboBox
                                ItemsSource="{Binding Browsers}"
                                SelectedItem="{Binding SelectedBrowser}"
                                IsEnabled="{Binding IsBrowserEnabled}"
                                Width="150"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16" />

                            <ui:TextBlock Text="Dépendances" FontTypography="BodyStrong" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding YtDlpStatusText, StringFormat='Moteur yt-dlp : {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding FfmpegStatusText, StringFormat='FFmpeg : {0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:Flyout>
                </StackPanel>
            </Grid>

            <!-- URL input -->
            <ui:CardControl Grid.Row="1" Margin="0,0,0,14" Padding="16">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            Grid.Column="0"
                            Text="Colle ou dépose tes liens"
                            FontTypography="BodyStrong" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding LinkCount, StringFormat='{}{0} lien(s)'}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            FontSize="12.5"
                            VerticalAlignment="Center" />
                    </Grid>
                </ui:CardControl.Header>
                <ui:CardControl.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ui:TextBox
                            Grid.Row="0"
                            x:Name="UrlsBox"
                            Text="{Binding UrlsText, UpdateSourceTrigger=PropertyChanged}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            VerticalScrollBarVisibility="Auto"
                            Height="96"
                            PlaceholderText="Colle un ou plusieurs liens, un par ligne, ou glisse un fichier .txt ici..."
                            PlaceholderEnabled="True"
                            Icon="{ui:SymbolIcon CloudArrowUp24}" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button
                                Content="Coller"
                                Icon="{ui:SymbolIcon ClipboardPaste20}"
                                Command="{Binding PasteCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Margin="0,0,8,0" />
                            <ui:Button
                                Content="Importer .txt"
                                Icon="{ui:SymbolIcon DocumentArrowUp20}"
                                Command="{Binding ImportTextFileCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Margin="0,0,8,0" />
                            <ui:Button
                                Content="Aperçu du 1er lien"
                                Icon="{ui:SymbolIcon Eye20}"
                                Command="{Binding PreviewFirstCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Margin="0,0,8,0" />
                            <ui:Button
                                Content="Effacer"
                                Appearance="Transparent"
                                Icon="{ui:SymbolIcon Delete20}"
                                Command="{Binding ClearCommand}"
                                IsEnabled="{Binding IsNotBusy}" />
                        </StackPanel>
                    </Grid>
                </ui:CardControl.Content>
            </ui:CardControl>

            <!-- Preview (only shown once a preview has been fetched) -->
            <Border
                Grid.Row="2"
                Margin="0,0,0,14"
                Padding="14"
                CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="96"
                        Height="64"
                        Margin="0,0,14,0"
                        CornerRadius="6"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        ClipToBounds="True">
                        <Image Source="{Binding PreviewThumbnail}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:TextBlock Text="{Binding PreviewTitle}" FontTypography="BodyStrong" TextWrapping="Wrap" />
                        <TextBlock
                            Text="{Binding PreviewMeta}"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Download options -->
            <ui:CardControl Grid.Row="3" Margin="0,0,0,14" Padding="16">
                <ui:CardControl.Header>
                    <ui:TextBlock Text="Options de téléchargement" FontTypography="BodyStrong" />
                </ui:CardControl.Header>
                <ui:CardControl.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Format" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox
                            Width="130"
                            ItemsSource="{Binding FormatOptions}"
                            SelectedIndex="{Binding FormatIndex}"
                            IsEnabled="{Binding IsNotBusy}"
                            Margin="0,0,20,0" />

                        <TextBlock Text="Qualité" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ComboBox
                            Width="150"
                            ItemsSource="{Binding QualityOptions}"
                            SelectedIndex="{Binding QualityIndex}"
                            IsEnabled="{Binding IsQualityEnabled}"
                            Margin="0,0,20,0" />

                        <ui:ToggleSwitch
                            OnContent="Playlists autorisées"
                            OffContent="Playlists autorisées"
                            IsChecked="{Binding AllowPlaylists}"
                            IsEnabled="{Binding IsNotBusy}" />
                    </StackPanel>
                </ui:CardControl.Content>
            </ui:CardControl>

            <!-- Queue -->
            <ui:CardControl Grid.Row="4" Margin="0,0,0,14" Padding="0">
                <ui:CardControl.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ui:TextBlock
                            Grid.Row="0"
                            Text="File de téléchargement"
                            FontTypography="BodyStrong"
                            Margin="16,14,16,4" />

                        <StackPanel
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsQueueEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ui:SymbolIcon
                                Symbol="ArrowDownload24"
                                FontSize="28"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock
                                Text="Rien à télécharger pour l'instant"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Margin="0,8,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="QueueItemsControl" ItemsSource="{Binding Queue}" Margin="8,0,8,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:QueueItemViewModel}">
                                        <Border
                                            Padding="10,9"
                                            CornerRadius="6"
                                            Margin="0,2"
                                            Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Ellipse
                                                    Grid.Column="0"
                                                    Width="8"
                                                    Height="8"
                                                    Margin="2,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource AccentDotStyle}" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" Width="90">
                                                    <ui:TextBlock Text="{Binding Platform}" FontTypography="Caption" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{Binding DisplayText}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding DetailText}" />
                                                    <ProgressBar
                                                        Height="3"
                                                        Margin="0,4,0,0"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        Value="{Binding Progress, Mode=OneWay}"
                                                        Visibility="{Binding State, Converter={StaticResource ActiveStateToVisibilityConverter}, FallbackValue=Collapsed}" />
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="3"
                                                    Text="{Binding StatusText}"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0" />

                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ui:SymbolIcon Style="{StaticResource QueueStateIconStyle}" Margin="0,0,4,0" />
                                                    <ui:Button
                                                        Appearance="Transparent"
                                                        Icon="{ui:SymbolIcon ArrowClockwise16}"
                                                        ToolTip="Réessayer"
                                                        Padding="4"
                                                        Command="{Binding DataContext.RetryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </ui:CardControl.Content>
            </ui:CardControl>

            <!-- Output folder -->
            <Grid Grid.Row="5" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="Enregistrer dans"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0" />
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding OutputFolder}"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <ui:Button
                    Grid.Column="2"
                    Content="Changer..."
                    Appearance="Transparent"
                    Command="{Binding ChooseFolderCommand}"
                    IsEnabled="{Binding IsNotBusy}" />
            </Grid>

            <!-- Primary actions -->
            <Grid Grid.Row="6" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button
                    Grid.Column="0"
                    Content="{Binding PrimaryActionLabel}"
                    Appearance="Primary"
                    FontSize="14.5"
                    Padding="0,10"
                    Command="{Binding DownloadOrCancelCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="{Binding PrimaryActionIcon}" />
                    </ui:Button.Icon>
                </ui:Button>

                <ui:Button
                    Grid.Column="1"
                    Content="Réessayer les échecs"
                    Margin="10,0,0,0"
                    Command="{Binding RetryFailedCommand}"
                    Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />

                <ui:Button
                    Grid.Column="2"
                    Content="Copier erreurs"
                    Appearance="Transparent"
                    Margin="8,0,0,0"
                    Command="{Binding CopyErrorsCommand}"
                    Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
            </Grid>

            <ui:Button
                Grid.Row="6"
                HorizontalAlignment="Right"
                Margin="0,44,0,0"
                Content="Ouvrir le dossier"
                Appearance="Transparent"
                Icon="{ui:SymbolIcon FolderOpen20}"
                Command="{Binding OpenFolderCommand}" />

            <!-- Status -->
            <ui:InfoBar
                Grid.Row="7"
                Title="{Binding InfoBarTitle}"
                Message="{Binding InfoBarMessage}"
                Severity="{Binding InfoBarSeverity}"
                IsOpen="{Binding IsInfoBarOpen}"
                IsClosable="True" />
        </Grid>
    </Grid>
</ui:FluentWindow>
