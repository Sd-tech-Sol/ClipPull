<ui:FluentWindow
    x:Class="ClipPull.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ClipPull.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:ClipPull.ViewModels"
    Title="ClipPull"
    Width="920"
    Height="760"
    MinWidth="760"
    MinHeight="620"
    AllowDrop="True"
    d:DataContext="{d:DesignInstance vm:MainViewModel, IsDesignTimeCreatable=True}"
    ExtendsContentIntoTitleBar="True"
    PreviewDragLeave="OnPreviewDragLeave"
    PreviewDragOver="OnPreviewDragOver"
    Drop="OnDrop"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource ClipPullBackgroundBrush}"
    Foreground="{DynamicResource ClipPullTextPrimaryBrush}"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <converters:StateToSymbolConverter x:Key="StateToSymbolConverter" />
        <converters:ActiveStateToVisibilityConverter x:Key="ActiveStateToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:WindowHeightToSettingsMaxHeightConverter x:Key="SettingsMaxHeightConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="QueueStateIconStyle" TargetType="ui:SymbolIcon">
            <Setter Property="Foreground" Value="{DynamicResource ClipPullTextTertiaryBrush}" />
            <Setter Property="Symbol" Value="{Binding State, Converter={StaticResource StateToSymbolConverter}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Completed">
                    <Setter Property="Foreground" Value="{DynamicResource ClipPullSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="AlreadyDownloaded">
                    <Setter Property="Foreground" Value="{DynamicResource ClipPullSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource ClipPullErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Cancelled">
                    <Setter Property="Foreground" Value="{DynamicResource ClipPullTextDisabledBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource ClipPullBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="ClipPull"
            Background="{DynamicResource ClipPullChromeBrush}"
            Foreground="{DynamicResource ClipPullTextPrimaryBrush}"
            ShowMaximize="True"
            ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="{DynamicResource ClipPullCyanBrush}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="28,4,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Product header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource App.DownloadYourMedia}" Style="{StaticResource ProductHeadingStyle}" />
                    <TextBlock
                        Text="{DynamicResource App.Tagline}"
                        Style="{StaticResource SecondaryTextStyle}"
                        Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border
                        Background="{DynamicResource ClipPullSurfaceSecondaryBrush}"
                        BorderBrush="{DynamicResource ClipPullBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="9,4"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        ToolTip="{DynamicResource Settings.ComponentsStatusTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="6"
                                Height="6"
                                Fill="{DynamicResource ClipPullCyanBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,7,0" />
                            <TextBlock Text="{Binding DependencySummaryText}" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>

                    <ui:Button
                        x:Name="AdvancedButton"
                        Appearance="Transparent"
                        AutomationProperties.Name="{DynamicResource Settings.Title}"
                        Command="{Binding ToggleAdvancedCommand}"
                        Icon="{ui:SymbolIcon Settings20}"
                        ToolTip="{DynamicResource Settings.Title}" />

                    <ui:Flyout
                        Placement="Left"
                        IsOpen="{Binding IsAdvancedOpen}"
                        Background="{DynamicResource ClipPullSurfaceElevatedBrush}"
                        BorderBrush="{DynamicResource ClipPullBorderStrongBrush}"
                        Foreground="{DynamicResource ClipPullTextPrimaryBrush}">
                        <ScrollViewer
                            Width="320"
                            MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}, Converter={StaticResource SettingsMaxHeightConverter}}"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border
                                    Width="34"
                                    Height="34"
                                    Background="{DynamicResource ClipPullAccentBrush}"
                                    CornerRadius="8"
                                    Margin="0,0,10,0">
                                    <ui:SymbolIcon
                                        Symbol="Settings20"
                                        Foreground="{DynamicResource ClipPullOnAccentBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Settings.Title}" Style="{StaticResource SectionHeadingStyle}" />
                                    <TextBlock Text="{DynamicResource Settings.Subtitle}" Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{DynamicResource Settings.Appearance}" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="132" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Settings.Theme}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                <ComboBox
                                    x:Name="ThemeSelector"
                                    Grid.Column="1"
                                    SelectedIndex="0"
                                    SelectionChanged="OnThemeSelectionChanged">
                                    <ComboBoxItem Content="{DynamicResource Settings.ThemeDark}" />
                                    <ComboBoxItem Content="{DynamicResource Settings.ThemeSystem}" />
                                    <ComboBoxItem Content="{DynamicResource Settings.ThemeLight}" />
                                </ComboBox>
                            </Grid>

                            <TextBlock Text="{DynamicResource Settings.LanguageSection}" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="132" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Settings.Language}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                <ComboBox
                                    x:Name="LanguageSelector"
                                    Grid.Column="1"
                                    SelectedIndex="0"
                                    SelectionChanged="OnLanguageSelectionChanged">
                                    <ComboBoxItem Content="{DynamicResource Settings.LanguageEnglish}" />
                                    <ComboBoxItem Content="{DynamicResource Settings.LanguageFrench}" />
                                </ComboBox>
                            </Grid>

                            <TextBlock Text="{DynamicResource Settings.History}" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,8" />
                            <ui:ToggleSwitch
                                OnContent="{DynamicResource Settings.AvoidDuplicates}"
                                OffContent="{DynamicResource Settings.AvoidDuplicates}"
                                IsChecked="{Binding UseHistory}"
                                Margin="0,0,0,4" />
                            <ui:Button
                                Content="{DynamicResource Settings.ClearHistory}"
                                Appearance="Transparent"
                                HorizontalAlignment="Left"
                                Icon="{ui:SymbolIcon HistoryDismiss20}"
                                Command="{Binding ClearHistoryCommand}"
                                Margin="0,0,0,16" />

                            <TextBlock Text="{DynamicResource Settings.Playlists}" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Settings.MaximumPerLink}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                <ui:NumberBox
                                    Grid.Column="1"
                                    Value="{Binding PlaylistLimit}"
                                    Minimum="1"
                                    Maximum="500"
                                    IsEnabled="{Binding IsPlaylistLimitEnabled}" />
                            </Grid>

                            <TextBlock Text="{DynamicResource Settings.BrowserSession}" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,8" />
                            <ui:ToggleSwitch
                                OnContent="{DynamicResource Settings.UseBrowserSession}"
                                OffContent="{DynamicResource Settings.UseBrowserSession}"
                                IsChecked="{Binding UseBrowserCookies}"
                                Margin="0,0,0,8" />
                            <ComboBox
                                ItemsSource="{Binding Browsers}"
                                SelectedItem="{Binding SelectedBrowser}"
                                IsEnabled="{Binding IsBrowserEnabled}"
                                Width="160"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16" />

                            <Border Height="1" Background="{DynamicResource ClipPullDividerBrush}" Margin="0,0,0,14" />
                            <TextBlock Text="{DynamicResource Settings.Components}" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="yt-dlp" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding YtDlpStatusText}" Style="{StaticResource CaptionTextStyle}" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="FFmpeg" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding FfmpegStatusText}" Style="{StaticResource CaptionTextStyle}" />
                            </Grid>
                        </StackPanel>
                        </ScrollViewer>
                    </ui:Flyout>
                </StackPanel>
            </Grid>

            <!-- Hero drop / paste surface -->
            <Border
                x:Name="DropZoneBorder"
                Grid.Row="1"
                Style="{StaticResource DropZoneSurfaceStyle}"
                Padding="20"
                Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="44"
                            Height="44"
                            CornerRadius="10"
                            Background="{DynamicResource ClipPullSurfaceElevatedBrush}"
                            Margin="0,0,12,0">
                            <ui:SymbolIcon
                                Symbol="ClipboardPaste24"
                                FontSize="22"
                                Foreground="{DynamicResource ClipPullCyanBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Text="{DynamicResource Links.DropHere}"
                                Style="{StaticResource HeroHeadingStyle}"
                                Visibility="{Binding HasLinks, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            <TextBlock
                                Text="{DynamicResource Links.PasteBelow}"
                                Style="{StaticResource SecondaryTextStyle}"
                                Visibility="{Binding HasLinks, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            <TextBlock
                                Text="{Binding LinkSummaryText}"
                                Style="{StaticResource HeroHeadingStyle}"
                                Visibility="{Binding HasLinks, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock
                                Text="{DynamicResource Links.ReviewThenChoose}"
                                Style="{StaticResource SecondaryTextStyle}"
                                Visibility="{Binding HasLinks, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <ui:Button
                            Grid.Column="2"
                            Appearance="Transparent"
                            AutomationProperties.Name="{DynamicResource Links.ClearAutomation}"
                            Command="{Binding ClearCommand}"
                            Icon="{ui:SymbolIcon Delete20}"
                            ToolTip="{DynamicResource Common.Clear}"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasLinks, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>

                    <ui:TextBox
                        x:Name="UrlsBox"
                        Grid.Row="1"
                        Text="{Binding UrlsText, UpdateSourceTrigger=PropertyChanged}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        VerticalContentAlignment="Top"
                        VerticalScrollBarVisibility="Auto"
                        PlaceholderText="https://..."
                        PlaceholderEnabled="True"
                        Margin="0,14,0,0"
                        AutomationProperties.Name="{DynamicResource Links.InputAutomation}">
                        <ui:TextBox.Style>
                            <Style TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
                                <Setter Property="Height" Value="42" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLinks}" Value="True">
                                        <Setter Property="Height" Value="76" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:TextBox.Style>
                    </ui:TextBox>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button
                            Grid.Column="0"
                            Content="{DynamicResource Links.Paste}"
                            Icon="{ui:SymbolIcon ClipboardPaste20}"
                            Command="{Binding PasteCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Margin="0,0,8,0" />
                        <ui:Button
                            Grid.Column="1"
                            Content="{DynamicResource Links.ImportTxt}"
                            Appearance="Transparent"
                            Icon="{ui:SymbolIcon DocumentArrowUp20}"
                            Command="{Binding ImportTextFileCommand}"
                            IsEnabled="{Binding IsNotBusy}" />
                        <ui:Button
                            Grid.Column="3"
                            Content="{DynamicResource Links.Preview}"
                            Appearance="Transparent"
                            Icon="{ui:SymbolIcon Eye20}"
                            Command="{Binding PreviewFirstCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Visibility="{Binding HasLinks, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>

                    <Border
                        Grid.Row="3"
                        Margin="0,14,0,0"
                        Padding="10"
                        CornerRadius="8"
                        Background="{DynamicResource ClipPullSurfaceSecondaryBrush}"
                        Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="96"
                                Height="54"
                                Margin="0,0,12,0"
                                CornerRadius="6"
                                Background="{DynamicResource ClipPullSurfaceHoverBrush}"
                                ClipToBounds="True">
                                <Image Source="{Binding PreviewThumbnail}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding PreviewTitle}"
                                    Style="{StaticResource SectionHeadingStyle}"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    MaxHeight="40" />
                                <TextBlock Text="{Binding PreviewMeta}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Compact selection and primary action -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource Options.Format}" Style="{StaticResource CaptionTextStyle}" Margin="2,0,0,5" />
                    <Border Style="{StaticResource SegmentContainerStyle}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton
                                Content="{DynamicResource Options.FormatVideo}"
                                GroupName="Format"
                                IsChecked="{Binding IsVideoSelected}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource SegmentRadioStyle}" />
                            <RadioButton
                                Content="{DynamicResource Options.FormatM4A}"
                                GroupName="Format"
                                IsChecked="{Binding IsM4aSelected}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource SegmentRadioStyle}" />
                            <RadioButton
                                Content="{DynamicResource Options.FormatMP3}"
                                GroupName="Format"
                                IsChecked="{Binding IsMp3Selected}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource SegmentRadioStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,16,0"
                    Visibility="{Binding IsVideoSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{DynamicResource Options.Quality}" Style="{StaticResource CaptionTextStyle}" Margin="2,0,0,5" />
                    <ComboBox
                        x:Name="QualitySelector"
                        Width="142"
                        Height="36"
                        AutomationProperties.Name="{DynamicResource Options.Quality}"
                        SelectedIndex="{Binding QualityIndex}"
                        IsEnabled="{Binding IsQualityEnabled}"
                        ToolTip="{DynamicResource Options.QualityAutoTooltip}">
                        <ComboBoxItem Content="{DynamicResource Options.QualityAuto}" />
                        <ComboBoxItem Content="{DynamicResource Options.QualityBest}" />
                        <ComboBoxItem Content="{DynamicResource Options.Quality1080}" />
                        <ComboBoxItem Content="{DynamicResource Options.Quality720}" />
                        <ComboBoxItem Content="{DynamicResource Options.Quality480}" />
                        <ComboBoxItem Content="{DynamicResource Options.QualitySmall}" />
                    </ComboBox>
                </StackPanel>

                <CheckBox
                    Grid.Column="2"
                    Content="{DynamicResource Options.Playlist}"
                    IsChecked="{Binding AllowPlaylists}"
                    IsEnabled="{Binding IsNotBusy}"
                    VerticalAlignment="Bottom"
                    Height="36"
                    Padding="0,7"
                    ToolTip="{DynamicResource Options.PlaylistTooltip}" />

                <ui:Button
                    Grid.Column="4"
                    Content="{Binding PrimaryActionLabel}"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    MinWidth="178"
                    Height="42"
                    VerticalAlignment="Bottom"
                    Command="{Binding DownloadOrCancelCommand}"
                    IsEnabled="{Binding CanUsePrimaryAction}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="{Binding PrimaryActionIcon}" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>

            <!-- Download queue -->
            <Border Grid.Row="3" Style="{StaticResource WorkingSurfaceStyle}" MinHeight="150" Margin="0,0,0,14" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,12,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Queue.Downloads}" Style="{StaticResource SectionHeadingStyle}" />
                            <TextBlock
                                Text="{Binding QueueSummaryText}"
                                Style="{StaticResource CaptionTextStyle}"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button
                                Content="{DynamicResource Queue.RetryAll}"
                                Appearance="Transparent"
                                Icon="{ui:SymbolIcon ArrowClockwise16}"
                                Command="{Binding RetryFailedCommand}"
                                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <ui:Button
                                Appearance="Transparent"
                                AutomationProperties.Name="{DynamicResource Queue.CopyErrors}"
                                Icon="{ui:SymbolIcon Copy20}"
                                ToolTip="{DynamicResource Queue.CopyErrors}"
                                Command="{Binding CopyErrorsCommand}"
                                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsQueueEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border
                            Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="{DynamicResource ClipPullSurfaceSecondaryBrush}"
                            HorizontalAlignment="Center">
                            <ui:SymbolIcon
                                Symbol="ArrowDownload24"
                                FontSize="22"
                                Foreground="{DynamicResource ClipPullCyanBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <TextBlock
                            Text="{DynamicResource Queue.EmptyTitle}"
                            Style="{StaticResource SectionHeadingStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0" />
                        <TextBlock
                            Text="{DynamicResource Queue.EmptyMessage}"
                            Style="{StaticResource CaptionTextStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,2,0,0" />
                    </StackPanel>

                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding IsQueueEmpty, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ItemsControl x:Name="QueueItemsControl" ItemsSource="{Binding Queue}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:QueueItemViewModel}">
                                    <Border Style="{StaticResource QueueRowStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                Grid.Column="0"
                                                Width="38"
                                                Height="38"
                                                CornerRadius="8"
                                                Background="{DynamicResource ClipPullSurfaceSecondaryBrush}"
                                                Margin="0,0,12,0">
                                                <ui:SymbolIcon
                                                    Symbol="VideoClip20"
                                                    Foreground="{DynamicResource ClipPullCyanBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>

                                            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock
                                                    Grid.Row="0"
                                                    Text="{Binding DisplayText}"
                                                    Style="{StaticResource BodyTextStyle}"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding DetailText}" />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Text="{Binding OptionsText}"
                                                    Style="{StaticResource CaptionTextStyle}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <ProgressBar
                                                    Grid.Row="2"
                                                    Style="{StaticResource ClipPullProgressBarStyle}"
                                                    Height="3"
                                                    Margin="0,6,0,0"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    Value="{Binding Progress, Mode=OneWay}"
                                                    Visibility="{Binding State, Converter={StaticResource ActiveStateToVisibilityConverter}}" />
                                            </Grid>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <ui:SymbolIcon Style="{StaticResource QueueStateIconStyle}" Margin="0,0,6,0" />
                                                <TextBlock
                                                    Text="{Binding StatusDisplayText}"
                                                    Style="{StaticResource CaptionTextStyle}"
                                                    MinWidth="92"
                                                    TextAlignment="Right"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>

                                            <ui:Button
                                                Grid.Column="3"
                                                Appearance="Transparent"
                                                AutomationProperties.Name="{DynamicResource Queue.RetryItemAutomation}"
                                                Icon="{ui:SymbolIcon ArrowClockwise16}"
                                                ToolTip="{DynamicResource Common.Retry}"
                                                Padding="5"
                                                Command="{Binding DataContext.RetryItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Secondary output location -->
            <Grid Grid.Row="4" Margin="2,0,2,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon
                    Grid.Column="0"
                    Symbol="FolderOpen20"
                    Foreground="{DynamicResource ClipPullTextSecondaryBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Output.SaveTo}" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock
                        Text="{Binding OutputFolderDisplay}"
                        Style="{StaticResource BodyTextStyle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ui:Button
                    Grid.Column="2"
                    Content="{DynamicResource Output.Change}"
                    Appearance="Transparent"
                    Command="{Binding ChooseFolderCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Margin="8,0,0,0" />
                <ui:Button
                    Grid.Column="3"
                    Content="{DynamicResource Common.Open}"
                    Appearance="Transparent"
                    Icon="{ui:SymbolIcon Open20}"
                    Command="{Binding OpenFolderCommand}"
                    Margin="4,0,0,0" />
            </Grid>

            <ui:InfoBar
                Grid.Row="5"
                Title="{Binding InfoBarTitle}"
                Message="{Binding InfoBarMessage}"
                Severity="{Binding InfoBarSeverity}"
                IsOpen="{Binding IsInfoBarOpen}"
                IsClosable="True" />
        </Grid>
    </Grid>
</ui:FluentWindow>
